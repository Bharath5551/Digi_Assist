# Copy to .env and fill in. Never commit .env.

# Model provider. Default is NVIDIA's free hosted Nemotron (build.nvidia.com).
#   nvidia       free key from https://build.nvidia.com/settings/api-keys, ~40 requests/min
#   openrouter   key from openrouter.ai; MODEL like nvidia/nemotron-3-super-120b-a12b:free
#   openai_compat  any OpenAI-style server; set LLM_BASE_URL
#   anthropic    Claude; MODEL like claude-opus-5-5
LLM_PROVIDER=nvidia
LLM_API_KEY=nvapi-...
LLM_BASE_URL=
MODEL=nvidia/nemotron-3-super-120b-a12b
# Smaller model for routing when there are many skills. Empty = same as MODEL.
ROUTER_MODEL=
MAX_TOKENS=4096

# Telegram: create a bot with @BotFather, then message it once and read your numeric id from the logs.
TELEGRAM_BOT_TOKEN=123456:ABC...
TELEGRAM_OWNER_ID=0

# Database. Docker Compose sets this for you; for local dev sqlite works:
DATABASE_URL=sqlite+aiosqlite:///./assistant.db
# DATABASE_URL=postgresql+asyncpg://assistant:assistant@db:5432/assistant

# Google OAuth (Gmail + Calendar). Create a "Web application" OAuth client in Google Cloud Console,
# add PUBLIC_BASE_URL/oauth/google/callback as an authorised redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
PUBLIC_BASE_URL=http://localhost:8000

# 32 url-safe base64 bytes; generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# Your timezone and the time of the morning brief
TIMEZONE=Asia/Kolkata
BRIEF_TIME=05:00
